# .gitignore generated for the Zombie Plus project
# ------------------------------------------------------------
# 1️⃣ System files / IDE files
# ------------------------------------------------------------
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux temporary files
*~

# IDEs & editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Eclipse / NetBeans / IntelliJ Java project files
.project
.classpath
.settings/
*.iml

# ------------------------------------------------------------
# 2️⃣ Build / generated artefacts (Node, React, Java, Docker)
# ------------------------------------------------------------
# Node / npm / Yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React build output (static bundle)
build/
Dist/

# Gradle (Java)
.gradle/
build/
out/
*.jar
*.war
*.ear
**/build/reports/
**/build/test-results/
**/build/tmp/

# Docker
docker-compose.override.yml
# (docker-compose.yml is part of the repo – do NOT ignore it)

# ------------------------------------------------------------
# 3️⃣ Environment / secret files
# ------------------------------------------------------------
.env
.env.*
*.secret
*.key
*.pem
*.crt

# ------------------------------------------------------------
# 4️⃣ Logs & runtime files
# ------------------------------------------------------------
*.log
logs/
*.log.*

# ------------------------------------------------------------
# 5️⃣ Test fixtures (if generated at runtime)
# ------------------------------------------------------------
src/test/java/**/fixtures/**/*.json

# ------------------------------------------------------------
# 6️⃣ Miscellaneous temporary / backup files
# ------------------------------------------------------------
*~
*.bak
*.swp
/tmp/
temp/
temp-*/

# ------------------------------------------------------------
# 7️⃣ Exceptions – version these if you need them
# ------------------------------------------------------------
!.env.example
!docker/**/*.sh
